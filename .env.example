APP_NAME=SEO Autopilot AI
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Default: SQLite (zero setup). For Postgres:
# DATABASE_URL=postgresql+asyncpg://seo:seo@localhost:5432/seo_autopilot
DATABASE_URL=sqlite+aiosqlite:////tmp/seo_autopilot.db

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=60

MAX_PAGES_PER_CRAWL=50
MAX_CRAWL_DEPTH=4
CRAWL_DELAY_SECONDS=0.3

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=

# Platform admin bootstrap (server-side only – never put these in frontend)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Platform Admin

# Auth cookie
COOKIE_NAME=seo_access_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── PostgreSQL (Docker profile: postgres) ──────────────────────────
POSTGRES_USER=seo
POSTGRES_PASSWORD=seo_change_me
POSTGRES_DB=seo_autopilot
POSTGRES_PORT=5432
# Local API + Docker Postgres:
# DATABASE_URL=postgresql+asyncpg://seo:seo_change_me@localhost:5432/seo_autopilot
# Docker backend-pg uses host "postgres" automatically via compose.

# ── pgAdmin (Docker profile: postgres) ─────────────────────────────
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
# TLS for pgAdmin UI (https://localhost:5050)
# 1) bash scripts/generate-pgadmin-certs.sh
# 2) set:
# PGADMIN_ENABLE_TLS=True
# PGADMIN_CONTAINER_PORT=443
PGADMIN_ENABLE_TLS=
PGADMIN_CONTAINER_PORT=80

# ── PostgreSQL SSL ─────────────────────────────────────────────────
# bash scripts/generate-postgres-certs.sh
POSTGRES_SSL=off
# TLSv1.2 (default, allows 1.3) or TLSv1.3 (require 1.3 only)
POSTGRES_SSL_MIN_PROTOCOL=TLSv1.2
# When POSTGRES_SSL=true, use:
# DATABASE_URL=postgresql+asyncpg://seo:seo_change_me@localhost:5432/seo_autopilot?ssl=require
# Inside Docker network (backend-pg):
# DATABASE_URL=postgresql+asyncpg://seo:seo_change_me@postgres:5432/seo_autopilot?ssl=require
